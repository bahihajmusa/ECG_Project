            "text": "\"\"\"\nexport_ai8x.py\n==============\nGenerate every file that the Analog Devices MAX78002 toolchain needs, directly from the layer\nlist of the model in model.py / configs/edge_cnn.yaml, so that the model trained here and the\nmodel synthesized for the chip have the SAME topology:\n\n    max78002/model_configuration/models/ai85net-ecg.py       ai8x-training model (QAT, MAX78002 layers)\n    max78002/model_configuration/datasets/ecg_mitbih.py      ai8x-training dataset (our prepared beats)\n    max78002/model_configuration/networks/ecg_mitbih.yaml    ai8x-synthesis network description\n    max78002/model_configuration/policies/*.yaml             learning-rate schedule and QAT policy\n    max78002/model_configuration/scripts/*.sh                train / quantize / evaluate / synthesize commands\n    max78002/model_configuration/sample_input.npy            one VALIDATION beat as 8-bit input for synthesis\n    max78002/model_configuration/model_summary.json          architecture, parameter count, memory estimate\n\nUsage:\n    python export_ai8x.py --config ../configs/edge_cnn.yaml --out ../max78002\n\nThen follow max78002/README_toolchain.md (also summarised in the main README).\n\"\"\"\n\nimport os\nimport sys\nimport json\nimport argparse\n\nimport numpy as np\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom model import build_model, count_parameters, check_max78002_constraints, describe_architecture\nfrom utils import load_config\n\nMODEL_NAME = 'ai85ecgnet'          # name used by train.py --model\nMODEL_FILE = 'ai85net-ecg.py'\nDATASET_NAME = 'ECG_MITBIH'        # name used by train.py --dataset\nNETWORK_YAML = 'ecg_mitbih.yaml'\n\n\n# ----------------------------------------------------------------------------\n# ai8x-training model file\n# ----------------------------------------------------------------------------\n\ndef make_model_file(model, dropout: float) -> str:\n    lines = []\n    for i, b in enumerate(model.blocks, 1):\n        in_ch = b.conv.in_channels\n        out_ch = b.conv.out_channels\n        k, pad = b.kernel, b.pad\n        if b.pool_size > 1:\n            cls = 'FusedMaxPoolConv1dBNReLU'\n            extra = f', pool_size={b.pool_size}, pool_stride={b.pool_size}'\n        else:\n            cls = 'FusedConv1dBNReLU'\n            extra = ''\n        in_arg = 'num_channels' if i == 1 else str(in_ch)\n        lines.append(f\"        self.conv{i} = ai8x.{cls}({in_arg}, {out_ch}, {k}{extra}, stride=1, \"\n                     f\"padding={pad}, bias=bias, **kwargs)\")\n    convs = '\\n'.join(lines)\n    fwd = '\\n'.join(f'        x = self.conv{i}(x)' for i in range(1, len(model.blocks) + 1))\n    return f'''###################################################################################################\n# GENERATED by src/export_ai8x.py from configs/edge_cnn.yaml - regenerate instead of editing by hand.\n#\n# ECG heartbeat classification network for the MAX78002 (ai8x-training model file).\n# Copy this file to  ai8x-training/models/{MODEL_FILE}\n###################################################################################################\n\"\"\"\nNetwork for ECG beat classification (N / S / V / F), 1D CNN, input (1, 360).\n\nLayers (same as src/model.py EdgeECGNet):\n{chr(10).join('  ' + r['Layer'] + ': ' + r['Input'] + '  ' + r['Operation'] + '  -> ' + r['Output'] for r in describe_architecture(model))}\n\"\"\"\nfrom torch import nn\n\nimport ai8x\n\n\nclass AI85ECGNet(nn.Module):\n    \"\"\"1D CNN for 4-class ECG beat classification (360 samples, 1 channel).\"\"\"\n\n    def __init__(self, num_classes=4, num_channels=1, dimensions=(360, 1), bias=True, **kwargs):\n        super().__init__()\n        # The BatchNorm variants need bias=True: run train.py with --use-bias.\n{convs}\n        self.drop = nn.Dropout({dropout})\n        self.fc = ai8x.Linear({model.flat_features}, num_classes, bias=bias, wide=True, **kwargs)\n\n    def forward(self, x):  # pylint: disable=arguments-differ\n        \"\"\"Forward prop\"\"\"\n{fwd}\n        x = x.view(x.size(0), -1)\n        x = self.drop(x)\n        x = self.fc(x)\n        return x\n\n\ndef ai85ecgnet(pretrained=False, **kwargs):\n    \"\"\"Constructs the ECG network.\"\"\"\n    assert not pretrained\n    return AI85ECGNet(**kwargs)\n\n\nmodels = [\n    {{\n        'name': '{MODEL_NAME}',\n        'min_input': 1,\n        'dim': 1,\n    }},\n]\n'''\n\n\n# ----------------------------------------------------------------------------\n# ai8x-synthesis network YAML\n# ----------------------------------------------------------------------------\n\ndef make_network_yaml(model) -> str:\n    def mask(n):               # n input channels -> the n lowest processors\n        return f'0x{(1 << n) - 1:016x}'\n    return _dump_layers(model, ['0x2000', '0x0000'], mask)\n\n\ndef _dump_layers(model, offsets, mask) -> str:\n    out = ['---',\n           '# GENERATED by src/export_ai8x.py - network description for ai8x-synthesis (MAX78002)',\n           f'arch: {MODEL_NAME}',\n           f'dataset: {DATASET_NAME}',\n           '',\n           '# \"processors\" selects the processors that hold the INPUT channels of each layer.',\n           '# Output offsets alternate (0x2000 / 0x0000) so a layer never overwrites its own input.',\n           'layers:']\n    for i, b in enumerate(model.blocks):\n        items = []\n        if b.pool_size > 1:\n            items += [('max_pool', b.pool_size), ('pool_stride', b.pool_size)]\n        items += [('pad', b.pad), ('activate', 'ReLU'), ('out_offset', offsets[i % 2]),\n                  ('processors', mask(b.conv.in_channels))]\n        if i == 0:\n            items.append(('data_format', 'HWC'))\n        items += [('operation', 'Conv1d'), ('kernel_size', b.kernel)]\n        out.append(f'  # Layer {i}: conv{i + 1} ({b.conv.in_channels} -> {b.conv.out_channels} channels)')\n        for j, (k, v) in enumerate(items):\n            out.append(f\"  {'- ' if j == 0 else '  '}{k}: {v}\")\n    last = len(model.blocks)\n    out += [f'  # Layer {last}: fc (flatten {model.flat_features} features -> {model.num_classes} classes)',\n            f'  - out_offset: {offsets[last % 2]}',\n            f'    processors: {mask(model.blocks[-1].conv.out_channels)}',\n            '    operation: MLP',\n            '    flatten: true',\n            '    output_width: 32          # wide output: raw 32-bit scores (argmax = class)',\n            '']\n    return '\\n'.join(out)\n\n\n# ----------------------------------------------------------------------------\n# ai8x-training dataset file (standalone: ai8x-training does not import our src folder)\n# ----------------------------------------------------------------------------\n\nDATASET_TEMPLATE = '''###################################################################################################\n# GENERATED by src/export_ai8x.py - ECG_MITBIH dataset for ai8x-training.\n# Copy this file to  ai8x-training/datasets/ecg_mitbih.py\n# and the prepared beats (X_*.npy, y_*.npy from prepare_data.py) to  ai8x-training/data/ECG_MITBIH/\n###################################################################################################\n\"\"\"\nDataset of prepared MIT-BIH heartbeats (360 samples, 1 channel, classes N S V F).\n\nRules that keep the project honest:\n  * The training dataset contains the TRAINING records plus the VALIDATION records. The validation\n    beats are marked with `valid_indices`, so ai8x-training validates on them (split BY RECORD,\n    never random beats).\n  * The \"test\" dataset that ai8x-training evaluates is the VALIDATION set by default. The final\n    test set DS2 is only used when you set the environment variable ECG_TEST_SET=ds2\n    (do this once, at the very end).\n  * Augmentation (gain, small shift, baseline wander, noise) is applied to TRAINING beats only.\n\"\"\"\nimport os\n\nimport numpy as np\nimport torch\nfrom torch.utils.data import Dataset\n\nimport ai8x\n\nCLASS_NAMES = ('N', 'S', 'V', 'F')\n# class weights = total / (4 * count) from the TRAINING set (written by export_ai8x.py from class_weights.json)\nCLASS_WEIGHTS = __CLASS_WEIGHTS__\n\n\nclass ECGBeats(Dataset):\n    \"\"\"Prepared beats; x in [-1, 1] is mapped to [0, 1] so ai8x.normalize gives 8-bit values.\"\"\"\n\n    def __init__(self, X, y, augment_mask, transform):\n        self.X = X.astype(np.float32)\n        self.y = y.astype(np.int64)\n        self.augment_mask = augment_mask          # True for beats that may be augmented (training only)\n        self.transform = transform\n\n    def __len__(self):\n        return len(self.X)\n\n    def _augment(self, x):\n        x = x * np.random.uniform(0.9, 1.1)                                   # gain\n        s = np.random.randint(-3, 4)                                          # small time shift\n        if s != 0:\n            x2 = np.roll(x, s)\n            if s > 0:\n                x2[:s] = x[0]\n            else:\n                x2[s:] = x[-1]\n            x = x2\n        t = np.arange(len(x)) / 360.0                                         # baseline wander\n        x = x + np.random.uniform(0, 0.1) * (np.ptp(x) + 1e-10) * np.sin(\n            2 * np.pi * np.random.uniform(0.1, 0.5) * t + np.random.uniform(0, 2 * np.pi))\n        x = x + np.random.normal(0, 0.02 * max(np.std(x), 0.01), size=x.shape)  # sensor noise\n        return np.clip(x, -1.0, 1.0)\n\n    def __getitem__(self, idx):\n        x = self.X[idx].copy()\n        if self.augment_mask[idx]:\n            x = self._augment(x).astype(np.float32)\n        x01 = torch.from_numpy((x + 1.0) / 2.0).unsqueeze(0)                 # (1, 360) in [0, 1]\n        if self.transform is not None:\n            x01 = self.transform(x01)                                         # -> [-128, 127] / 128\n        return x01, torch.tensor(self.y[idx], dtype=torch.long)\n\n\ndef _load(root, split):\n    return (np.load(os.path.join(root, f'X_{split}.npy')), np.load(os.path.join(root, f'y_{split}.npy')))\n\n\ndef ecg_mitbih_get_datasets(data, load_train=True, load_test=True, aug=None):  # pylint: disable=unused-argument\n    \"\"\"Called by ai8x-training. `data` = (data_dir, args).\"\"\"\n    data_dir, args = data\n    root = os.path.join(data_dir, 'ECG_MITBIH')\n    transform = ai8x.normalize(args=args)\n\n    train_dataset = test_dataset = None\n    if load_train:\n        Xtr, ytr = _load(root, 'train')\n        Xva, yva = _load(root, 'val')\n        X = np.concatenate([Xtr, Xva])\n        y = np.concatenate([ytr, yva])\n        augment = np.concatenate([np.ones(len(Xtr), bool), np.zeros(len(Xva), bool)])   # never augment validation\n        train_dataset = ECGBeats(X, y, augment, transform)\n        train_dataset.valid_indices = list(range(len(Xtr), len(Xtr) + len(Xva)))        # validation BY RECORD\n    if load_test:\n        split = 'test' if os.environ.get('ECG_TEST_SET', 'val').lower() in ('ds2', 'test') else 'val'\n        Xte, yte = _load(root, split)\n        test_dataset = ECGBeats(Xte, yte, np.zeros(len(Xte), bool), transform)\n        print(f'[ECG_MITBIH] evaluation (\"test\") set = {\"DS2 (FINAL TEST)\" if split == \"test\" else \"validation records\"}')\n    return train_dataset, test_dataset\n\n\ndatasets = [\n    {\n        'name': 'ECG_MITBIH',\n        'input': (1, 360),\n        'output': CLASS_NAMES,\n        'weight': CLASS_WEIGHTS,\n        'loader': ecg_mitbih_get_datasets,\n    },\n]\n'''\n\n\n# ----------------------------------------------------------------------------\n# policies and scripts\n# ----------------------------------------------------------------------------\n\nSCHEDULE_YAML = '''---\n# Learning-rate schedule for ai8x-training (used with --compress)\nlr_schedulers:\n  training_lr:\n    class: MultiStepLR\n    milestones: [__M1__, __M2__, __M3__]\n    gamma: 0.5\n\npolicies:\n  - lr_scheduler:\n      instance_name: training_lr\n    starting_epoch: 0\n    ending_epoch: __EPOCHS__\n    frequency: 1\n'''\n\nQAT_YAML = '''---\n# Quantization-aware training policy: after `start_epoch` epochs, BatchNorm is folded and weights /\n# activations are trained with 8-bit fake quantization.\nstart_epoch: __START__\nweight_bits: 8\n'''\n\nTRAIN_SH = '''#!/bin/sh\n# Train (FP32 until the QAT start epoch, then quantization-aware) with ai8x-training.\n# Run this from inside the ai8x-training folder (after copying the files, see README_toolchain.md).\npython train.py --epochs __EPOCHS__ --optimizer Adam --lr 0.001 --wd 0 --deterministic \\\\\n  --compress policies/schedule_ecg.yaml --qat-policy policies/qat_policy_ecg.yaml \\\\\n  --model __MODEL__ --dataset __DATASET__ --use-bias --batch-size 128 \\\\\n  --confusion --param-hist --device MAX78002 \"$@\"\n'''\n\nQUANTIZE_SH = '''#!/bin/sh\n# Quantize the best QAT checkpoint to the 8-bit checkpoint that the synthesis tool reads.\n# Run from inside the ai8x-synthesis folder.\npython quantize.py trained/qat_best.pth.tar trained/ecg-qat8-q.pth.tar --device MAX78002 -v \"$@\"\n'''\n\nEVAL_SH = '''#!/bin/sh\n# Evaluate the quantized checkpoint with the ai8x-training framework (8-bit mode).\n# Run from inside the ai8x-training folder. By default the \"test\" set is the VALIDATION records.\n# For the FINAL evaluation on DS2 (once, at the very end):   ECG_TEST_SET=ds2 sh evaluate_ecg.sh\nCKPT=${CKPT:-../ai8x-synthesis/trained/ecg-qat8-q.pth.tar}\npython train.py --model __MODEL__ --dataset __DATASET__ --use-bias --confusion --evaluate \\\\\n  --exp-load-weights-from \"$CKPT\" -8 --device MAX78002 \"$@\"\n'''\n\nSYNTH_SH = '''#!/bin/sh\n# Generate the MAX78002 C project (weights, configuration, test code) with ai8x-synthesis.\n# Run from inside the ai8x-synthesis folder.\npython ai8xize.py --verbose --test-dir synthesis_output --prefix ecg_mitbih \\\\\n  --checkpoint-file trained/ecg-qat8-q.pth.tar --config-file networks/__YAML__ \\\\\n  --sample-input tests/sample_ecg_mitbih.npy --device MAX78002 \\\\\n  --compact-data --mexpress --timer 0 --display-checkpoint --overwrite --softmax \"$@\"\n'''\n\n\ndef fill(template: str, **kw) -> str:\n    for k, v in kw.items():\n        template = template.replace(f'__{k}__', str(v))\n    return template\n\n\ndef write(path, text):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    with open(path, 'w') as f:\n        f.write(text)\n    return path\n\n\ndef main():\n    ap = argparse.ArgumentParser(description='Generate MAX78002 (ai8x) files from the model definition')\n    ap.add_argument('--config', default='../configs/edge_cnn.yaml')\n    ap.add_argument('--out', default='../max78002')\n    ap.add_argument('--epochs', type=int, default=100, help='ai8x-training epochs (FP32 + QAT)')\n    ap.add_argument('--qat-start', type=int, default=60, help='epoch where quantization-aware training starts')\n    ap.add_argument('--class-weights', nargs=4, type=float, default=None, metavar='W',\n                    help='override class weights N S V F (default: read class_weights.json)')\n    args = ap.parse_args()\n\n    cfg = load_config(args.config)\n    base = os.path.dirname(os.path.abspath(args.config))\n    processed = os.path.normpath(os.path.join(base, cfg['paths']['processed_dir']))\n    out = args.out if os.path.isabs(args.out) else os.path.normpath(os.path.join(base, args.out))\n    mc = os.path.join(out, 'model_configuration')\n\n    model = build_model(cfg['model'])\n    chk = check_max78002_constraints(model)\n    if not chk['ok']:\n        sys.exit(f\"Model violates MAX78002 rules: {chk['problems']}\")\n\n    # class weights from the training set (prepare_data.py)\n    cw_path = os.path.join(processed, 'class_weights.json')\n    if args.class_weights:\n        weights = tuple(round(w, 4) for w in args.class_weights)\n    elif os.path.exists(cw_path):\n        with open(cw_path) as f:\n            cw = json.load(f)\n        power = cfg['training'].get('class_weight_power', 1.0)\n        weights = tuple(round(float(cw[str(i)]) ** power, 4) for i in range(4))\n    else:\n        weights = (1.0, 1.0, 1.0, 1.0)\n        print('WARNING: class_weights.json not found, using equal weights. Run prepare_data.py first.')\n\n    paths = [\n        write(os.path.join(mc, 'models', MODEL_FILE), make_model_file(model, cfg['model'].get('dropout', 0.0))),\n        write(os.path.join(mc, 'networks', NETWORK_YAML), make_network_yaml(model)),\n        write(os.path.join(mc, 'datasets', 'ecg_mitbih.py'), DATASET_TEMPLATE.replace('__CLASS_WEIGHTS__', repr(weights))),\n        write(os.path.join(mc, 'policies', 'schedule_ecg.yaml'), fill(SCHEDULE_YAML, M1=int(args.epochs * 0.5), M2=int(args.epochs * 0.75),\n                                                                        M3=int(args.epochs * 0.9), EPOCHS=args.epochs)),\n        write(os.path.join(mc, 'policies', 'qat_policy_ecg.yaml'), fill(QAT_YAML, START=args.qat_start)),\n        write(os.path.join(mc, 'scripts', 'train_ecg.sh'), fill(TRAIN_SH, EPOCHS=args.epochs, MODEL=MODEL_NAME, DATASET=DATASET_NAME)),\n        write(os.path.join(mc, 'scripts', 'quantize_ecg.sh'), QUANTIZE_SH),\n        write(os.path.join(mc, 'scripts', 'evaluate_ecg.sh'), fill(EVAL_SH, MODEL=MODEL_NAME, DATASET=DATASET_NAME)),\n        write(os.path.join(mc, 'scripts', 'synthesize_ecg.sh'), fill(SYNTH_SH, YAML=NETWORK_YAML)),\n    ]\n\n    # sample input: first VALIDATION beat as int64 in [-128, 127], shape (channels, length)\n    xv = os.path.join(processed, 'X_val.npy')\n    if os.path.exists(xv):\n        beat = np.load(xv)[0]\n        sample = np.clip(np.round(beat * 128.0), -128, 127).astype(np.int64).reshape(1, -1)\n        os.makedirs(mc, exist_ok=True)\n        np.save(os.path.join(mc, 'sample_input.npy'), sample)\n        paths.append(os.path.join(mc, 'sample_input.npy'))\n    else:\n        print('NOTE: X_val.npy not found; sample_input.npy not created (run prepare_data.py first).')\n\n    summary = {\n        'model_file': MODEL_FILE, 'model_name': MODEL_NAME, 'dataset': DATASET_NAME,\n        'input_shape': [model.in_channels, model.input_length], 'output': model.num_classes,\n        'layers': describe_architecture(model),\n        'parameters_deployed': count_parameters(model, True),\n        'parameters_trainable_with_bn': count_parameters(model, False),\n        'weight_bytes_int8': chk['weight_bytes_int8'],\n        'estimated_peak_activation_bytes_int8': max(\n            (r_in + r_out) for r_in, r_out in _activation_sizes(model)),\n        'pre_check': chk,\n    }\n    write(os.path.join(mc, 'model_summary.json'), json.dumps(summary, indent=2))\n    print('Generated:')\n    for p in paths + [os.path.join(mc, 'model_summary.json')]:\n        print('  ', os.path.relpath(p, os.getcwd()))\n    print(f\"Parameters (deployed): {summary['parameters_deployed']:,} | INT8 weight bytes: {summary['weight_bytes_int8']:,} | \"\n          f\"estimated peak activations: {summary['estimated_peak_activation_bytes_int8']:,} bytes\")\n\n\ndef _activation_sizes(model):\n    \"\"\"(input bytes, output bytes) of every layer for 8-bit activations (an estimate, not the chip's exact layout).\"\"\"\n    ch, length, res = model.in_channels, model.input_length, []\n    for b in model.blocks:\n        in_bytes = ch * length\n        if b.pool_size > 1:\n            length //= b.pool_size\n        ch = b.conv.out_channels\n        res.append((in_bytes, ch * length))\n    res.append((ch * length, model.num_classes * 4))      # wide output: 4 bytes per class\n    return res\n\n\nif __name__ == '__main__':\n    main()\n",
            "selection": {
              "anchor": 0,
              "head": 0
            }
          },
          "saved_text": "\"\"\"\nexport_ai8x.py\n==============\nGenerate every file that the Analog Devices MAX78002 toolchain needs, directly from the layer\nlist of the model in model.py / configs/edge_cnn.yaml, so that the model trained here and the\nmodel synthesized for the chip have the SAME topology:\n\n    max78002/model_configuration/models/ai85net-ecg.py       ai8x-training model (QAT, MAX78002 layers)\n    max78002/model_configuration/datasets/ecg_mitbih.py      ai8x-training dataset (our prepared beats)\n    max78002/model_configuration/networks/ecg_mitbih.yaml    ai8x-synthesis network description\n    max78002/model_configuration/policies/*.yaml             learning-rate schedule and QAT policy\n    max78002/model_configuration/scripts/*.sh                train / quantize / evaluate / synthesize commands\n    max78002/model_configuration/sample_input.npy            one VALIDATION beat as 8-bit input for synthesis\n    max78002/model_configuration/model_summary.json          architecture, parameter count, memory estimate\n\nUsage:\n    python export_ai8x.py --config ../configs/edge_cnn.yaml --out ../max78002\n\nThen follow max78002/README_toolchain.md (also summarised in the main README).\n\"\"\"\n\nimport os\nimport sys\nimport json\nimport argparse\n\nimport numpy as np\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom model import build_model, count_parameters, check_max78002_constraints, describe_architecture\nfrom utils import load_config\n\nMODEL_NAME = 'ai85ecgnet'          # name used by train.py --model\nMODEL_FILE = 'ai85net-ecg.py'\nDATASET_NAME = 'ECG_MITBIH'        # name used by train.py --dataset\nNETWORK_YAML = 'ecg_mitbih.yaml'\n\n\n# ----------------------------------------------------------------------------\n# ai8x-training model file\n# ----------------------------------------------------------------------------\n\ndef make_model_file(model, dropout: float) -> str:\n    lines = []\n    for i, b in enumerate(model.blocks, 1):\n        in_ch = b.conv.in_channels\n        out_ch = b.conv.out_channels\n        k, pad = b.kernel, b.pad\n        if b.pool_size > 1:\n            cls = 'FusedMaxPoolConv1dBNReLU'\n            extra = f', pool_size={b.pool_size}, pool_stride={b.pool_size}'\n        else:\n            cls = 'FusedConv1dBNReLU'\n            extra = ''\n        in_arg = 'num_channels' if i == 1 else str(in_ch)\n        lines.append(f\"        self.conv{i} = ai8x.{cls}({in_arg}, {out_ch}, {k}{extra}, stride=1, \"\n                     f\"padding={pad}, bias=bias, **kwargs)\")\n    convs = '\\n'.join(lines)\n    fwd = '\\n'.join(f'        x = self.conv{i}(x)' for i in range(1, len(model.blocks) + 1))\n    return f'''###################################################################################################\n# GENERATED by src/export_ai8x.py from configs/edge_cnn.yaml - regenerate instead of editing by hand.\n#\n# ECG heartbeat classification network for the MAX78002 (ai8x-training model file).\n# Copy this file to  ai8x-training/models/{MODEL_FILE}\n###################################################################################################\n\"\"\"\nNetwork for ECG beat classification (N / S / V / F), 1D CNN, input (1, 360).\n\nLayers (same as src/model.py EdgeECGNet):\n{chr(10).join('  ' + r['Layer'] + ': ' + r['Input'] + '  ' + r['Operation'] + '  -> ' + r['Output'] for r in describe_architecture(model))}\n\"\"\"\nfrom torch import nn\n\nimport ai8x\n\n\nclass AI85ECGNet(nn.Module):\n    \"\"\"1D CNN for 4-class ECG beat classification (360 samples, 1 channel).\"\"\"\n\n    def __init__(self, num_classes=4, num_channels=1, dimensions=(360, 1), bias=True, **kwargs):\n        super().__init__()\n        # The BatchNorm variants need bias=True: run train.py with --use-bias.\n{convs}\n        self.drop = nn.Dropout({dropout})\n        self.fc = ai8x.Linear({model.flat_features}, num_classes, bias=bias, wide=True, **kwargs)\n\n    def forward(self, x):  # pylint: disable=arguments-differ\n        \"\"\"Forward prop\"\"\"\n{fwd}\n        x = x.view(x.size(0), -1)\n        x = self.drop(x)\n        x = self.fc(x)\n        return x\n\n\ndef ai85ecgnet(pretrained=False, **kwargs):\n    \"\"\"Constructs the ECG network.\"\"\"\n    assert not pretrained\n    return AI85ECGNet(**kwargs)\n\n\nmodels = [\n    {{\n        'name': '{MODEL_NAME}',\n        'min_input': 1,\n        'dim': 1,\n    }},\n]\n'''\n\n\n# ----------------------------------------------------------------------------\n# ai8x-synthesis network YAML\n# ----------------------------------------------------------------------------\n\ndef make_network_yaml(model) -> str:\n    def mask(n):               # n input channels -> the n lowest processors\n        return f'0x{(1 << n) - 1:016x}'\n    return _dump_layers(model, ['0x2000', '0x0000'], mask)\n\n\ndef _dump_layers(model, offsets, mask) -> str:\n    out = ['---',\n           '# GENERATED by src/export_ai8x.py - network description for ai8x-synthesis (MAX78002)',\n           f'arch: {MODEL_NAME}',\n           f'dataset: {DATASET_NAME}',\n           '',\n           '# \"processors\" selects the processors that hold the INPUT channels of each layer.',\n           '# Output offsets alternate (0x2000 / 0x0000) so a layer never overwrites its own input.',\n           'layers:']\n    for i, b in enumerate(model.blocks):\n        items = []\n        if b.pool_size > 1:\n            items += [('max_pool', b.pool_size), ('pool_stride', b.pool_size)]\n        items += [('pad', b.pad), ('activate', 'ReLU'), ('out_offset', offsets[i % 2]),\n                  ('processors', mask(b.conv.in_channels))]\n        if i == 0:\n            items.append(('data_format', 'HWC'))\n        items += [('operation', 'Conv1d'), ('kernel_size', b.kernel)]\n        out.append(f'  # Layer {i}: conv{i + 1} ({b.conv.in_channels} -> {b.conv.out_channels} channels)')\n        for j, (k, v) in enumerate(items):\n            out.append(f\"  {'- ' if j == 0 else '  '}{k}: {v}\")\n    last = len(model.blocks)\n    out += [f'  # Layer {last}: fc (flatten {model.flat_features} features -> {model.num_classes} classes)',\n            f'  - out_offset: {offsets[last % 2]}',\n            f'    processors: {mask(model.blocks[-1].conv.out_channels)}',\n            '    operation: MLP',\n            '    flatten: true',\n            '    output_width: 32          # wide output: raw 32-bit scores (argmax = class)',\n            '']\n    return '\\n'.join(out)\n\n\n# ----------------------------------------------------------------------------\n# ai8x-training dataset file (standalone: ai8x-training does not import our src folder)\n# ----------------------------------------------------------------------------\n\nDATASET_TEMPLATE = '''###################################################################################################\n# GENERATED by src/export_ai8x.py - ECG_MITBIH dataset for ai8x-training.\n# Copy this file to  ai8x-training/datasets/ecg_mitbih.py\n# and the prepared beats (X_*.npy, y_*.npy from prepare_data.py) to  ai8x-training/data/ECG_MITBIH/\n###################################################################################################\n\"\"\"\nDataset of prepared MIT-BIH heartbeats (360 samples, 1 channel, classes N S V F).\n\nRules that keep the project honest:\n  * The training dataset contains the TRAINING records plus the VALIDATION records. The validation\n    beats are marked with `valid_indices`, so ai8x-training validates on them (split BY RECORD,\n    never random beats).\n  * The \"test\" dataset that ai8x-training evaluates is the VALIDATION set by default. The final\n    test set DS2 is only used when you set the environment variable ECG_TEST_SET=ds2\n    (do this once, at the very end).\n  * Augmentation (gain, small shift, baseline wander, noise) is applied to TRAINING beats only.\n\"\"\"\nimport os\n\nimport numpy as np\nimport torch\nfrom torch.utils.data import Dataset\n\nimport ai8x\n\nCLASS_NAMES = ('N', 'S', 'V', 'F')\n# class weights = total / (4 * count) from the TRAINING set (written by export_ai8x.py from class_weights.json)\nCLASS_WEIGHTS = __CLASS_WEIGHTS__\n\n\nclass ECGBeats(Dataset):\n    \"\"\"Prepared beats; x in [-1, 1] is mapped to [0, 1] so ai8x.normalize gives 8-bit values.\"\"\"\n\n    def __init__(self, X, y, augment_mask, transform):\n        self.X = X.astype(np.float32)\n        self.y = y.astype(np.int64)\n        self.augment_mask = augment_mask          # True for beats that may be augmented (training only)\n        self.transform = transform\n\n    def __len__(self):\n        return len(self.X)\n\n    def _augment(self, x):\n        x = x * np.random.uniform(0.9, 1.1)                                   # gain\n        s = np.random.randint(-3, 4)                                          # small time shift\n        if s != 0:\n            x2 = np.roll(x, s)\n            if s > 0:\n                x2[:s] = x[0]\n            else:\n                x2[s:] = x[-1]\n            x = x2\n        t = np.arange(len(x)) / 360.0                                         # baseline wander\n        x = x + np.random.uniform(0, 0.1) * (np.ptp(x) + 1e-10) * np.sin(\n            2 * np.pi * np.random.uniform(0.1, 0.5) * t + np.random.uniform(0, 2 * np.pi))\n        x = x + np.random.normal(0, 0.02 * max(np.std(x), 0.01), size=x.shape)  # sensor noise\n        return np.clip(x, -1.0, 1.0)\n\n    def __getitem__(self, idx):\n        x = self.X[idx].copy()\n        if self.augment_mask[idx]:\n            x = self._augment(x).astype(np.float32)\n        x01 = torch.from_numpy((x + 1.0) / 2.0).unsqueeze(0)                 # (1, 360) in [0, 1]\n        if self.transform is not None:\n            x01 = self.transform(x01)                                         # -> [-128, 127] / 128\n        return x01, torch.tensor(self.y[idx], dtype=torch.long)\n\n\ndef _load(root, split):\n    return (np.load(os.path.join(root, f'X_{split}.npy')), np.load(os.path.join(root, f'y_{split}.npy')))\n\n\ndef ecg_mitbih_get_datasets(data, load_train=True, load_test=True, aug=None):  # pylint: disable=unused-argument\n    \"\"\"Called by ai8x-training. `data` = (data_dir, args).\"\"\"\n    data_dir, args = data\n    root = os.path.join(data_dir, 'ECG_MITBIH')\n    transform = ai8x.normalize(args=args)\n\n    train_dataset = test_dataset = None\n    if load_train:\n        Xtr, ytr = _load(root, 'train')\n        Xva, yva = _load(root, 'val')\n        X = np.concatenate([Xtr, Xva])\n        y = np.concatenate([ytr, yva])\n        augment = np.concatenate([np.ones(len(Xtr), bool), np.zeros(len(Xva), bool)])   # never augment validation\n        train_dataset = ECGBeats(X, y, augment, transform)\n        train_dataset.valid_indices = list(range(len(Xtr), len(Xtr) + len(Xva)))        # validation BY RECORD\n    if load_test:\n        split = 'test' if os.environ.get('ECG_TEST_SET', 'val').lower() in ('ds2', 'test') else 'val'\n        Xte, yte = _load(root, split)\n        test_dataset = ECGBeats(Xte, yte, np.zeros(len(Xte), bool), transform)\n        print(f'[ECG_MITBIH] evaluation (\"test\") set = {\"DS2 (FINAL TEST)\" if split == \"test\" else \"validation records\"}')\n    return train_dataset, test_dataset\n\n\ndatasets = [\n    {\n        'name': 'ECG_MITBIH',\n        'input': (1, 360),\n        'output': CLASS_NAMES,\n        'weight': CLASS_WEIGHTS,\n        'loader': ecg_mitbih_get_datasets,\n    },\n]\n'''\n\n\n# ----------------------------------------------------------------------------\n# policies and scripts\n# ----------------------------------------------------------------------------\n\nSCHEDULE_YAML = '''---\n# Learning-rate schedule for ai8x-training (used with --compress)\nlr_schedulers:\n  training_lr:\n    class: MultiStepLR\n    milestones: [__M1__, __M2__, __M3__]\n    gamma: 0.5\n\npolicies:\n  - lr_scheduler:\n      instance_name: training_lr\n    starting_epoch: 0\n    ending_epoch: __EPOCHS__\n    frequency: 1\n'''\n\nQAT_YAML = '''---\n# Quantization-aware training policy: after `start_epoch` epochs, BatchNorm is folded and weights /\n# activations are trained with 8-bit fake quantization.\nstart_epoch: __START__\nweight_bits: 8\n'''\n\nTRAIN_SH = '''#!/bin/sh\n# Train (FP32 until the QAT start epoch, then quantization-aware) with ai8x-training.\n# Run this from inside the ai8x-training folder (after copying the files, see README_toolchain.md).\npython train.py --epochs __EPOCHS__ --optimizer Adam --lr 0.001 --wd 0 --deterministic \\\\\n  --compress policies/schedule_ecg.yaml --qat-policy policies/qat_policy_ecg.yaml \\\\\n  --model __MODEL__ --dataset __DATASET__ --use-bias --batch-size 128 \\\\\n  --confusion --param-hist --device MAX78002 \"$@\"\n'''\n\nQUANTIZE_SH = '''#!/bin/sh\n# Quantize the best QAT checkpoint to the 8-bit checkpoint that the synthesis tool reads.\n# Run from inside the ai8x-synthesis folder.\npython quantize.py trained/qat_best.pth.tar trained/ecg-qat8-q.pth.tar --device MAX78002 -v \"$@\"\n'''\n\nEVAL_SH = '''#!/bin/sh\n# Evaluate the quantized checkpoint with the ai8x-training framework (8-bit mode).\n# Run from inside the ai8x-training folder. By default the \"test\" set is the VALIDATION records.\n# For the FINAL evaluation on DS2 (once, at the very end):   ECG_TEST_SET=ds2 sh evaluate_ecg.sh\nCKPT=${CKPT:-../ai8x-synthesis/trained/ecg-qat8-q.pth.tar}\npython train.py --model __MODEL__ --dataset __DATASET__ --use-bias --confusion --evaluate \\\\\n  --exp-load-weights-from \"$CKPT\" -8 --device MAX78002 \"$@\"\n'''\n\nSYNTH_SH = '''#!/bin/sh\n# Generate the MAX78002 C project (weights, configuration, test code) with ai8x-synthesis.\n# Run from inside the ai8x-synthesis folder.\npython ai8xize.py --verbose --test-dir synthesis_output --prefix ecg_mitbih \\\\\n  --checkpoint-file trained/ecg-qat8-q.pth.tar --config-file networks/__YAML__ \\\\\n  --sample-input tests/sample_ecg_mitbih.npy --device MAX78002 \\\\\n  --compact-data --mexpress --timer 0 --display-checkpoint --overwrite --softmax \"$@\"\n'''\n\n\ndef fill(template: str, **kw) -> str:\n    for k, v in kw.items():\n        template = template.replace(f'__{k}__', str(v))\n    return template\n\n\ndef write(path, text):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    with open(path, 'w') as f:\n        f.write(text)\n    return path\n\n\ndef main():\n    ap = argparse.ArgumentParser(description='Generate MAX78002 (ai8x) files from the model definition')\n    ap.add_argument('--config', default='../configs/edge_cnn.yaml')\n    ap.add_argument('--out', default='../max78002')\n    ap.add_argument('--epochs', type=int, default=100, help='ai8x-training epochs (FP32 + QAT)')\n    ap.add_argument('--qat-start', type=int, default=60, help='epoch where quantization-aware training starts')\n    ap.add_argument('--class-weights', nargs=4, type=float, default=None, metavar='W',\n                    help='override class weights N S V F (default: read class_weights.json)')\n    args = ap.parse_args()\n\n    cfg = load_config(args.config)\n    base = os.path.dirname(os.path.abspath(args.config))\n    processed = os.path.normpath(os.path.join(base, cfg['paths']['processed_dir']))\n    out = args.out if os.path.isabs(args.out) else os.path.normpath(os.path.join(base, args.out))\n    mc = os.path.join(out, 'model_configuration')\n\n    model = build_model(cfg['model'])\n    chk = check_max78002_constraints(model)\n    if not chk['ok']:\n        sys.exit(f\"Model violates MAX78002 rules: {chk['problems']}\")\n\n    # class weights from the training set (prepare_data.py)\n    cw_path = os.path.join(processed, 'class_weights.json')\n    if args.class_weights:\n        weights = tuple(round(w, 4) for w in args.class_weights)\n    elif os.path.exists(cw_path):\n        with open(cw_path) as f:\n            cw = json.load(f)\n        power = cfg['training'].get('class_weight_power', 1.0)\n        weights = tuple(round(float(cw[str(i)]) ** power, 4) for i in range(4))\n    else:\n        weights = (1.0, 1.0, 1.0, 1.0)\n        print('WARNING: class_weights.json not found, using equal weights. Run prepare_data.py first.')\n\n    paths = [\n        write(os.path.join(mc, 'models', MODEL_FILE), make_model_file(model, cfg['model'].get('dropout', 0.0))),\n        write(os.path.join(mc, 'networks', NETWORK_YAML), make_network_yaml(model)),\n        write(os.path.join(mc, 'datasets', 'ecg_mitbih.py'), DATASET_TEMPLATE.replace('__CLASS_WEIGHTS__', repr(weights))),\n        write(os.path.join(mc, 'policies', 'schedule_ecg.yaml'), fill(SCHEDULE_YAML, M1=int(args.epochs * 0.5), M2=int(args.epochs * 0.75),\n                                                                        M3=int(args.epochs * 0.9), EPOCHS=args.epochs)),\n        write(os.path.join(mc, 'policies', 'qat_policy_ecg.yaml'), fill(QAT_YAML, START=args.qat_start)),\n        write(os.path.join(mc, 'scripts', 'train_ecg.sh'), fill(TRAIN_SH, EPOCHS=args.epochs, MODEL=MODEL_NAME, DATASET=DATASET_NAME)),\n        write(os.path.join(mc, 'scripts', 'quantize_ecg.sh'), QUANTIZE_SH),\n        write(os.path.join(mc, 'scripts', 'evaluate_ecg.sh'), fill(EVAL_SH, MODEL=MODEL_NAME, DATASET=DATASET_NAME)),\n        write(os.path.join(mc, 'scripts', 'synthesize_ecg.sh'), fill(SYNTH_SH, YAML=NETWORK_YAML)),\n    ]\n\n    # sample input: first VALIDATION beat as int64 in [-128, 127], shape (channels, length)\n    xv = os.path.join(processed, 'X_val.npy')\n    if os.path.exists(xv):\n        beat = np.load(xv)[0]\n        sample = np.clip(np.round(beat * 128.0), -128, 127).astype(np.int64).reshape(1, -1)\n        os.makedirs(mc, exist_ok=True)\n        np.save(os.path.join(mc, 'sample_input.npy'), sample)\n        paths.append(os.path.join(mc, 'sample_input.npy'))\n    else:\n        print('NOTE: X_val.npy not found; sample_input.npy not created (run prepare_data.py first).')\n\n    summary = {\n        'model_file': MODEL_FILE, 'model_name': MODEL_NAME, 'dataset': DATASET_NAME,\n        'input_shape': [model.in_channels, model.input_length], 'output': model.num_classes,\n        'layers': describe_architecture(model),\n        'parameters_deployed': count_parameters(model, True),\n        'parameters_trainable_with_bn': count_parameters(model, False),\n        'weight_bytes_int8': chk['weight_bytes_int8'],\n        'estimated_peak_activation_bytes_int8': max(\n            (r_in + r_out) for r_in, r_out in _activation_sizes(model)),\n        'pre_check': chk,\n    }\n    write(os.path.join(mc, 'model_summary.json'), json.dumps(summary, indent=2))\n    print('Generated:')\n    for p in paths + [os.path.join(mc, 'model_summary.json')]:\n        print('  ', os.path.relpath(p, os.getcwd()))\n    print(f\"Parameters (deployed): {summary['parameters_deployed']:,} | INT8 weight bytes: {summary['weight_bytes_int8']:,} | \"\n          f\"estimated peak activations: {summary['estimated_peak_activation_bytes_int8']:,} bytes\")\n\n\ndef _activation_sizes(model):\n    \"\"\"(input bytes, output bytes) of every layer for 8-bit activations (an estimate, not the chip's exact layout).\"\"\"\n    ch, length, res = model.in_channels, model.input_length, []\n    for b in model.blocks:\n        in_bytes = ch * length\n        if b.pool_size > 1:\n            length //= b.pool_size\n        ch = b.conv.out_channels\n        res.append((in_bytes, ch * length))\n    res.append((ch * length, model.num_classes * 4))      # wide output: 4 bytes per class\n    return res\n\n\nif __name__ == '__main__':\n    main()\n",
          "saved_baseline_known": true,
